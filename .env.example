# Copy to .env and fill in. .env is gitignored — never commit real values.

# PayPal SANDBOX credentials: developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Any OpenAI-compatible chat-completions endpoint with tool calling
# (OpenAI, Z.ai GLM, local Ollama, ...). If you only have an Anthropic key,
# a small adapter is added instead.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

PORT=8788
