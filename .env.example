# Copy to .env and fill in. .env is gitignored — never commit real values.

# PayPal SANDBOX credentials: developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Any OpenAI-compatible chat-completions endpoint with tool calling
# (Z.ai GLM, OpenAI, local Ollama, ...). GLM 5.3 Flash verified:
# coding-plan keys use https://api.z.ai/api/coding/paas/v4; standard keys use
# https://api.z.ai/api/paas/v4.
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash

PORT=8788
