# Copy to .env and fill in. .env is gitignored — never commit real values.

# PayPal SANDBOX credentials: developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Any OpenAI-compatible chat-completions endpoint with tool calling
# (Z.ai GLM, OpenAI, local Ollama, ...). GLM 5.3 Flash verified:
# coding-plan keys use https://api.z.ai/api/coding/paas/v4; standard keys use
# https://api.z.ai/api/paas/v4.
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash

# Per-turn LLM spend clamp in lib/llm.js (default 2048, hard ceiling 4096)
LLM_MAX_TOKENS=2048

# Admin bearer for the Phase 0-secure gates: /mcp tools/call on
# trailhead_create_order / trailhead_refund_order (fail-closed when unset) and
# the admin override on /api/capture + /api/orders. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=

PORT=8788
